{% comment %}
  Renders one photography collection's body.

  Params:
    gallery  collection slug — keys both site.data.photography and site.data.photos

  Chapter-grouped collections show a tile per chapter, each opening its own page
  (generated by _plugins/photography-chapters.rb); the photographs themselves live
  on those pages, which keeps any single page's weight bounded as a collection
  grows. Ungrouped collections still render one continuous justified grid.

  Photographs whose tag matched no chapter have no chapter page to live on, so
  they render here in a trailing block rather than disappearing.
{% endcomment %}

{% assign meta = site.data.photography | where: 'slug', include.gallery | first %}
{% assign manifest = site.data.photos[include.gallery] %}

{% if manifest == null or manifest.size == 0 %}
  <p class="gallery-empty">
    No photos imported yet. Run <code>bin/import-flickr {{ include.gallery }} --tags --user &lt;you&gt;</code>.
  </p>
{% elsif meta.group_by_location %}
  {% include chapter_index.liquid gallery=include.gallery %}

  {% assign unlabeled = manifest | where_exp: 'photo', 'photo.location == blank' %}
  {% if unlabeled.size > 0 %}
    <div class="gallery-body">
      <h2 class="gallery-section">Unsorted</h2>
      {% include photo_grid.liquid photos=unlabeled gallery=include.gallery %}
    </div>
  {% endif %}
{% else %}
  <div class="gallery-body">
    {% include photo_grid.liquid photos=manifest gallery=include.gallery %}
  </div>
{% endif %}
