#!/usr/bin/env python3
"""Import photographs into a gallery collection from local originals.

Reads full-size files from a source directory, writes two web-sized derivatives
per photo into assets/img/photography/<slug>/, and updates the collection's
manifest in _data/photos/. Originals are never copied into the repo.

    bin/import-photos <slug> <source-dir> [--location NAME] [options]

Typical use, one park at a time:

    bin/import-photos big-five-2021 /Volumes/Jba/D800/zion   --location "Zion"
    bin/import-photos big-five-2021 /Volumes/Jba/D800/bryce  --location "Bryce Canyon"
    bin/import-photos kyrgyzstan-2026 /Volumes/Jba/D800/kg

Re-running with the same --location replaces just that location's entries and
keeps every caption you have already written by hand. Location names must match
the `locations` list for the collection in _data/photography.yml.

Use bin/import-flickr instead to source photos from Flickr rather than a drive.

Requires ImageMagick on PATH. Raw formats (.nef) additionally need libraw or
dcraw available to ImageMagick as a delegate; if it is missing, export JPEGs or
TIFFs from Lightroom first and point this at those.
"""

import argparse
import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import photolib as lib

EXTENSIONS = (".jpg", ".jpeg", ".png", ".tif", ".tiff", ".nef", ".dng", ".cr2", ".arw")

DISPLAY_EDGE = 2400
DISPLAY_QUALITY = 82
THUMB_EDGE = 800
THUMB_QUALITY = 78


def fail(message):
    sys.exit("error: %s" % message)


def magick():
    for candidate in ("magick", "convert"):
        path = shutil.which(candidate)
        if path:
            return [path]
    fail("ImageMagick not found on PATH (brew install imagemagick)")


def identify(path):
    exe = shutil.which("magick")
    cmd = [exe, "identify"] if exe else [shutil.which("identify")]
    out = subprocess.run(
        cmd + ["-format", "%w %h", path + "[0]"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.split()
    return int(out[0]), int(out[1])


def convert(src, dest, edge, quality, sharpen):
    """Downscale to a long edge, flatten to sRGB, strip metadata (incl. GPS)."""
    cmd = magick() + [
        src + "[0]",
        "-auto-orient",
        "-colorspace",
        "sRGB",
        "-resize",
        "%dx%d>" % (edge, edge),
    ]
    if sharpen:
        cmd += ["-unsharp", "0x0.6+0.6+0.02"]
    cmd += [
        "-strip",
        "-interlace",
        "Plane",
        "-sampling-factor",
        "4:2:0",
        "-quality",
        str(quality),
        dest,
    ]
    subprocess.run(cmd, check=True, capture_output=True)


def main():
    parser = argparse.ArgumentParser(
        description="Import photographs into a gallery collection from local originals.",
        epilog="Originals stay on the drive; only web-sized derivatives enter the repo.",
    )
    parser.add_argument("slug", help="collection slug, e.g. big-five-2021")
    parser.add_argument("source", help="directory of full-size originals")
    parser.add_argument(
        "--location",
        default="",
        help="location label for this batch, e.g. 'Zion' (must match _data/photography.yml)",
    )
    parser.add_argument("--limit", type=int, default=0, help="import at most N photos (alphabetical)")
    parser.add_argument("--dry-run", action="store_true", help="list what would be imported and exit")
    args = parser.parse_args()

    if args.slug not in lib.collection_slugs():
        fail("unknown collection %r. Known: %s" % (args.slug, ", ".join(lib.collection_slugs()) or "(none)"))

    if not os.path.isdir(args.source):
        fail("source directory not readable: %s\n"
             "       If this is an external drive, grant your terminal Full Disk Access\n"
             "       in System Settings > Privacy & Security." % args.source)

    if args.location:
        allowed = lib.known_locations(args.slug)
        if allowed is None:
            fail("_data/photography.yml not found")
        if allowed and args.location not in allowed:
            fail(
                "location %r is not listed for collection %r.\n"
                "       Known locations: %s\n"
                "       Add it to _data/photography.yml (order there controls page order)."
                % (args.location, args.slug, ", ".join(allowed) or "(none)")
            )

    sources = sorted(
        entry.path
        for entry in os.scandir(args.source)
        if entry.is_file() and entry.name.lower().endswith(EXTENSIONS) and not entry.name.startswith(".")
    )
    if not sources:
        fail("no images found in %s (looked for %s)" % (args.source, ", ".join(EXTENSIONS)))
    if args.limit:
        sources = sources[: args.limit]

    if args.dry_run:
        print("Would import %d photo(s) into %r as location %r:" % (len(sources), args.slug, args.location))
        for path in sources:
            print("  %s  ->  %s" % (os.path.basename(path), lib.slugify(path) + ".jpg"))
        return

    out_dir = os.path.join(lib.IMG_ROOT, args.slug)
    thumb_dir = os.path.join(out_dir, "thumbs")
    os.makedirs(thumb_dir, exist_ok=True)

    manifest_path = os.path.join(lib.DATA_DIR, "%s.yml" % args.slug)
    existing = lib.read_manifest(manifest_path)

    fresh = []
    for index, src in enumerate(sources, 1):
        name = lib.slugify(src) + ".jpg"
        display = os.path.join(out_dir, name)
        thumb = os.path.join(thumb_dir, name)

        print("[%d/%d] %s" % (index, len(sources), name), flush=True)
        try:
            convert(src, display, DISPLAY_EDGE, DISPLAY_QUALITY, sharpen=False)
            convert(src, thumb, THUMB_EDGE, THUMB_QUALITY, sharpen=True)
        except subprocess.CalledProcessError as error:
            stderr = (error.stderr or b"").decode("utf-8", "replace").strip()
            print("  skipped: ImageMagick failed — %s" % (stderr.splitlines()[-1] if stderr else "unknown"))
            continue

        width, height = identify(display)
        tw, th = identify(thumb)
        fresh.append(
            {
                "file": name,
                "location": args.location,
                "caption": "",
                "w": width,
                "h": height,
                "tw": tw,
                "th": th,
                "ar": round(width / height, 4),
            }
        )

    if not fresh:
        fail("nothing imported")

    fresh = lib.carry_captions(existing, fresh)
    merged = lib.merge(existing, fresh, args.location)
    lib.write_manifest(manifest_path, merged, args.slug)

    total = sum(
        os.path.getsize(os.path.join(root, f))
        for root, _, files in os.walk(out_dir)
        for f in files
    )
    print(
        "\nImported %d photo(s) as location %r.\n"
        "  images:   assets/img/photography/%s/ (%.1f MB on disk)\n"
        "  manifest: _data/photos/%s.yml — add captions there\n"
        "  preview:  bundle exec jekyll serve  ->  /photography/%s/"
        % (len(fresh), args.location, args.slug, total / 1e6, args.slug, args.slug)
    )


if __name__ == "__main__":
    main()
