---
layout: default
---
{% assign meta = site.data.photography | where: 'slug', page.gallery | first %}
{% assign manifest = site.data.photos[page.gallery] %}
{% assign photos = manifest | where: 'location', page.chapter %}

<div class="post gallery-page">
  <header class="post-header">
    <p class="chapter-collection">
      <a href="{{ '/photography/' | append: page.gallery | append: '/' | relative_url }}">{{ meta.title }}</a>
    </p>
    <h1 class="post-title">{{ page.chapter }}</h1>
    <p class="post-description">
      {{ page.chapter_position }} of {{ page.chapter_total }} &middot; {{ photos.size }} photograph
      {%- if photos.size != 1 %}s{% endif %}
    </p>
  </header>

  <article>
    <div class="gallery-body">
      {% include photo_grid.liquid photos=photos gallery=page.gallery %}
    </div>
  </article>

  <nav class="chapter-nav">
    {% if page.prev_chapter %}
      <a
        class="chapter-nav-prev"
        href="{{ '/photography/' | append: page.gallery | append: '/' | append: page.prev_chapter.url | append: '/' | relative_url }}"
      >
        &larr; {{ page.prev_chapter.name }}
      </a>
    {% else %}
      <span></span>
    {% endif %}

    {% if page.next_chapter %}
      <a
        class="chapter-nav-next"
        href="{{ '/photography/' | append: page.gallery | append: '/' | append: page.next_chapter.url | append: '/' | relative_url }}"
      >
        {{ page.next_chapter.name }} &rarr;
      </a>
    {% else %}
      <span></span>
    {% endif %}
  </nav>
</div>
